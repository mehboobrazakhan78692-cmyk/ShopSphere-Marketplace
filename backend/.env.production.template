# PRODUCTION ENVIRONMENT VARIABLES (COPY TO VERCEL/RENDER)

# General
NODE_ENV=production
PORT=10000

# MongoDB (Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ShopSphere?retryWrites=true&w=majority

# PostgreSQL (Render DB or External)
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DB=

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_STRING

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=

# Frontend/Backend URLs
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
